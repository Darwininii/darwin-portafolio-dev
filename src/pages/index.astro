---
import Layout from "../layouts/Layout.astro";
import { User, Briefcase, Code2 } from "@lucide/astro";
import AboutMe from "../components/AboutMe.astro";
import Experience from "../components/Experience.astro";
import Projects from "../components/Projects.astro";
import Container from "../components/Container.astro";
import Hero from "../components/Hero.astro";
import TitleSection from "../components/TitleSection.astro";
import DownloadCV from "../components/DownloadCV.astro";
---

<Layout
  title="Portafolio de Darwin Niño - Ingeniero de Sistemas y Desarrollador Web"
  description="Portafolio de Darwin Niño, Ingeniero de Sistemas y Desarrollador Web, apasionado por la tecnología y el aprendizaje continuo."
>
  <main>
    <!-- Hero Section -->
    <Container class="pt-24 pb-16 md:pt-32 md:pb-24">
      <Hero />
    </Container>

    <!-- About Me -->
    <Container id="sobre-mi" class="py-16 md:py-20">
      <TitleSection>
        <User class="size-7 text-[var(--color-accent)]" />
        Sobre mí
      </TitleSection>
      <AboutMe />
      <DownloadCV />
    </Container>

    <!-- Experience -->
    <Container id="experiencia" class="py-16 md:py-20">
      <TitleSection>
        <Briefcase class="size-7 text-[var(--color-accent)]" />
        Experiencia laboral
      </TitleSection>
      <Experience />
    </Container>

    <!-- Projects -->
    <Container id="proyectos" class="py-16 md:py-20">
      <TitleSection>
        <Code2 class="size-7 text-[var(--color-accent)]" />
        Proyectos
      </TitleSection>
      <Projects />
    </Container>
  </main>
</Layout>
