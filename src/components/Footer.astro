---
import { Heart, ExternalLink } from "@lucide/astro";
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto">
  <!-- Gradient top border -->
  <div
    class="h-px bg-gradient-to-r from-transparent via-[var(--color-accent)]/30 to-transparent"
  >
  </div>

  <div class="w-full max-w-4xl mx-auto px-4 py-10 md:py-14">
    <!-- Top row -->
    <div
      class="flex flex-col sm:flex-row items-center justify-between gap-6 mb-8"
    >
      <a href="/" class="flex items-center gap-3 group">
        <img
          src="/darwin.png"
          class="rounded-full size-10 ring-1 ring-[var(--color-border)] transition-transform group-hover:scale-110"
          alt="Darwin Logo"
        />
        <span
          class="text-xl font-bold bg-gradient-to-r from-[var(--color-accent)] to-[var(--color-accent-secondary)] bg-clip-text text-transparent"
        >
          Darwinini
        </span>
      </a>

      <nav>
        <ul class="flex flex-wrap items-center gap-6 text-sm">
          <li>
            <a
              href="/#proyectos"
              class="text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors"
            >
              Proyectos
            </a>
          </li>
          <li>
            <a
              id="contacto"
              href="mailto:darwninoe@gmail.com"
              class="text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors"
            >
              Contacto
            </a>
          </li>
          <li>
            <a
              href="https://vaki.co/es/vaki/Darwinini?utm_source=copy&utm_medium=toolbar&utm_campaign=v4"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-1.5 text-[var(--color-text-muted)] hover:text-[var(--color-accent-warm)] transition-colors"
            >
              Donaciones
              <Heart class="size-4" />
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <!-- Divider -->
    <div class="h-px bg-[var(--color-border)] mb-6"></div>

    <!-- Support message -->
    <p
      class="text-center text-sm text-[var(--color-text-muted)] mb-4 max-w-lg mx-auto leading-relaxed"
    >
      Si deseas apoyarme en el camino para alcanzar mis metas y proyectos, tu
      contribución será recibida con gratitud y compromiso.
      <a
        href="https://vaki.co/es/vaki/Darwinini?utm_source=copy&utm_medium=toolbar&utm_campaign=v4"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-1 text-[var(--color-accent-warm)] hover:underline ml-1"
      >
        Donar <ExternalLink class="size-3" />
      </a>
    </p>

    <!-- Copyright -->
    <p class="text-center text-xs text-[var(--color-text-muted)]">
      &copy; {currentYear}
      <a
        href="https://www.linkedin.com/in/darwin-ni%C3%B1o/"
        target="_blank"
        rel="noopener"
        class="hover:text-[var(--color-accent)] transition-colors"
      >
        Darwinini™
      </a>. Todos los Derechos Reservados.
    </p>
  </div>
</footer>
