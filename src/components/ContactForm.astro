---
import {
  Send,
  User,
  Phone,
  Mail,
  MessageSquare,
  AlertCircle,
  CheckCircle2,
  CircleCheckBig,
  CircleAlert,
  CircleX,
} from "@lucide/astro";

import SocialPill from "./SocialPill.astro";

// 1. Leemos la variable del .env en el servidor (Frontmatter de Astro)
const web3formsKey =
  import.meta.env.WEB3FORMS_KEY || import.meta.env.PUBLIC_WEB3FORMS_KEY;
---

<div class="max-w-2xl mx-auto reveal">
  <div
    class="glass-card rounded-2xl p-6 sm:p-8 md:p-10 border border-[var(--color-border)] shadow-2xl relative overflow-hidden"
  >
    <!-- Ambient subtle background glow inside card -->
    <div
      class="absolute -top-24 -right-24 size-48 rounded-full bg-[var(--color-accent)]/15 blur-3xl pointer-events-none"
    >
    </div>
    <div
      class="absolute -bottom-24 -left-24 size-48 rounded-full bg-[var(--color-accent-secondary)]/15 blur-3xl pointer-events-none"
    >
    </div>

    <p
      class="text-sm md:text-base text-[var(--color-text-secondary)] mb-8 text-pretty leading-relaxed"
    >
      ¿Tienes algún proyecto en mente, una oportunidad laboral o simplemente
      quieres saludar? Déjame un mensaje y me pondré en contacto contigo lo más
      pronto posible.
    </p>

    <!-- 2. Le pasamos la clave al dataset del formulario -->
    <form
      id="contact-form"
      class="space-y-5"
      data-key={web3formsKey}
      novalidate
    >
      <!-- Grid: Nombre y Teléfono -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <!-- Nombre -->
        <div class="space-y-2">
          <label
            for="contact-name"
            class="block text-xs font-semibold uppercase tracking-wider text-[var(--color-text-secondary)]"
          >
            Nombre <span class="text-rose-500">*</span>
          </label>
          <div class="relative">
            <div
              class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 dark:text-zinc-500"
            >
              <User class="size-4" />
            </div>
            <input
              type="text"
              id="contact-name"
              name="name"
              required
              placeholder="Tu nombre completo"
              class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-300 dark:border-zinc-700/80 bg-white/80 dark:bg-zinc-900/70 text-slate-900 dark:text-zinc-100 placeholder:text-slate-400 dark:placeholder:text-zinc-500 focus:outline-none focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-glow)] transition-all duration-200 shadow-sm"
            />
          </div>
        </div>

        <!-- Teléfono -->
        <div class="space-y-2">
          <label
            for="contact-phone"
            class="block text-xs font-semibold uppercase tracking-wider text-[var(--color-text-secondary)]"
          >
            Teléfono <span
              class="text-[var(--color-text-muted)] text-[10px] font-normal"
              >(Opcional)</span
            >
          </label>
          <div class="relative">
            <div
              class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 dark:text-zinc-500"
            >
              <Phone class="size-4" />
            </div>
            <input
              type="tel"
              id="contact-phone"
              name="phone"
              placeholder="+57 300 123 4567"
              class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-300 dark:border-zinc-700/80 bg-white/80 dark:bg-zinc-900/70 text-slate-900 dark:text-zinc-100 placeholder:text-slate-400 dark:placeholder:text-zinc-500 focus:outline-none focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-glow)] transition-all duration-200 shadow-sm"
            />
          </div>
        </div>
      </div>

      <!-- Grid: Correo y Asunto -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <!-- Correo remitente -->
        <div class="space-y-2">
          <label
            for="contact-email"
            class="block text-xs font-semibold uppercase tracking-wider text-[var(--color-text-secondary)]"
          >
            Tu Correo <span class="text-rose-500">*</span>
          </label>
          <div class="relative">
            <div
              class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 dark:text-zinc-500"
            >
              <Mail class="size-4" />
            </div>
            <input
              type="email"
              id="contact-email"
              name="email"
              required
              placeholder="tu@correo.com"
              class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-300 dark:border-zinc-700/80 bg-white/80 dark:bg-zinc-900/70 text-slate-900 dark:text-zinc-100 placeholder:text-slate-400 dark:placeholder:text-zinc-500 focus:outline-none focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-glow)] transition-all duration-200 shadow-sm"
            />
          </div>
        </div>

        <!-- Asunto -->
        <div class="space-y-2">
          <label
            for="contact-subject"
            class="block text-xs font-semibold uppercase tracking-wider text-[var(--color-text-secondary)]"
          >
            Asunto <span class="text-rose-500">*</span>
          </label>
          <div class="relative">
            <div
              class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 dark:text-zinc-500"
            >
              <MessageSquare class="size-4" />
            </div>
            <input
              type="text"
              id="contact-subject"
              name="subject"
              required
              placeholder="Motivo de tu mensaje"
              class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-300 dark:border-zinc-700/80 bg-white/80 dark:bg-zinc-900/70 text-slate-900 dark:text-zinc-100 placeholder:text-slate-400 dark:placeholder:text-zinc-500 focus:outline-none focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-glow)] transition-all duration-200 shadow-sm"
            />
          </div>
        </div>
      </div>

      <!-- Mensaje / Descripción -->
      <div class="space-y-2">
        <label
          for="contact-message"
          class="block text-xs font-semibold uppercase tracking-wider text-[var(--color-text-secondary)]"
        >
          Mensaje / Descripción <span class="text-rose-500">*</span>
        </label>
        <textarea
          id="contact-message"
          name="message"
          required
          rows="5"
          placeholder="Escribe aquí tu mensaje o los detalles del proyecto..."
          class="w-full p-4 rounded-xl border border-slate-300 dark:border-zinc-700/80 bg-white/80 dark:bg-zinc-900/70 text-slate-900 dark:text-zinc-100 placeholder:text-slate-400 dark:placeholder:text-zinc-500 focus:outline-none focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-glow)] transition-all duration-200 resize-y overflow-y-auto shadow-sm"
        ></textarea>
      </div>

      <!-- Submit button -->
      <div class="pt-2">
        <SocialPill type="submit" id="contact-submit-btn">
          <span class="btn-text">Enviar mensaje</span>
          <Send class="size-4 transition-transform group-hover:translate-x-1" />
        </SocialPill>
      </div>
    </form>
  </div>
</div>

<!-- CONTENEDOR DEL TOAST -->
<div
  id="contact-toast"
  role="alert"
  aria-live="assertive"
  class="fixed bottom-6 right-6 z-[100] max-w-sm w-[calc(100vw-3rem)] p-4 rounded-2xl border shadow-2xl backdrop-blur-2xl flex items-start gap-3.5 transition-all duration-500 ease-out translate-y-12 opacity-0 pointer-events-none"
>
  <!-- Ícono con contenedor dinámico -->
  <div
    id="toast-icon-wrapper"
    class="p-2 rounded-xl shrink-0 mt-0.5 transition-colors duration-300"
  >
    <span id="toast-icon-success" class="hidden text-emerald-400">
      <CircleCheckBig class="size-5" />
    </span>
    <span id="toast-icon-error" class="hidden text-rose-400">
      <CircleAlert class="size-5" />
    </span>
  </div>

  <!-- Contenido de texto -->
  <div class="flex-1 pr-1">
    <h4
      id="toast-title"
      class="text-sm font-semibold tracking-wide text-zinc-100"
    >
    </h4>
    <p
      id="toast-message"
      class="text-xs text-zinc-300/90 mt-1 leading-relaxed font-normal"
    >
    </p>
  </div>

  <!-- Botón de Cierre -->
  <button
    id="toast-close-btn"
    type="button"
    class="text-zinc-400 hover:text-white hover:bg-white/10 rounded-lg p-1 transition-all duration-200 cursor-pointer -mr-1 -mt-1 shrink-0"
    aria-label="Cerrar notificación"
  >
    <CircleX class="size-6" />
  </button>
</div>

<script is:inline>
  function initContactForm() {
    const form = document.getElementById("contact-form");
    if (!form || form.dataset.init) return;
    form.dataset.init = "true";

    const submitBtn = document.getElementById("contact-submit-btn");
    const btnText = submitBtn?.querySelector(".btn-text");

    const toast = document.getElementById("contact-toast");
    const toastTitle = document.getElementById("toast-title");
    const toastMessage = document.getElementById("toast-message");
    const toastIconSuccess = document.getElementById("toast-icon-success");
    const toastIconError = document.getElementById("toast-icon-error");
    const toastCloseBtn = document.getElementById("toast-close-btn");

    let toastTimer = null;

    function showToast(type, title, message) {
      if (!toast) return;
      if (toastTimer) clearTimeout(toastTimer);

      const iconWrapper = document.getElementById("toast-icon-wrapper");

      if (type === "success") {
        toast.className =
          "fixed bottom-6 right-6 z-[100] max-w-sm w-[calc(100vw-3rem)] p-4 rounded-2xl border backdrop-blur-2xl flex items-start gap-3.5 transition-all duration-500 ease-out translate-y-0 opacity-100 pointer-events-auto bg-slate-950/85 border-emerald-500/30 shadow-[0_10px_30px_-5px_rgba(16,185,129,0.25)]";
        if (iconWrapper)
          iconWrapper.className =
            "p-2 rounded-xl shrink-0 mt-0.5 bg-emerald-500/10 border border-emerald-500/20";
        toastIconSuccess?.classList.remove("hidden");
        toastIconError?.classList.add("hidden");
      } else {
        toast.className =
          "fixed bottom-6 right-6 z-[100] max-w-sm w-[calc(100vw-3rem)] p-4 rounded-2xl border backdrop-blur-2xl flex items-start gap-3.5 transition-all duration-500 ease-out translate-y-0 opacity-100 pointer-events-auto bg-slate-950/85 border-rose-500/30 shadow-[0_10px_30px_-5px_rgba(244,63,94,0.25)]";
        if (iconWrapper)
          iconWrapper.className =
            "p-2 rounded-xl shrink-0 mt-0.5 bg-rose-500/10 border border-rose-500/20";
        toastIconSuccess?.classList.add("hidden");
        toastIconError?.classList.remove("hidden");
      }

      if (toastTitle) toastTitle.textContent = title;
      if (toastMessage) toastMessage.textContent = message;

      toastTimer = setTimeout(() => {
        hideToast();
      }, 5500);
    }

    function hideToast() {
      if (!toast) return;
      toast.classList.remove(
        "translate-y-0",
        "opacity-100",
        "pointer-events-auto",
      );
      toast.classList.add("translate-y-12", "opacity-0", "pointer-events-none");
    }

    toastCloseBtn?.addEventListener("click", hideToast);

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      // 3. Obtenemos la llave desde el dataset del formulario
      const accessKey = form.dataset.key;

      if (!accessKey) {
        showToast(
          "error",
          "Error de envío",
          "No se configuró la clave de API (Web3Forms Key).",
        );
        return;
      }

      const name = document.getElementById("contact-name")?.value.trim() || "";
      const phone =
        document.getElementById("contact-phone")?.value.trim() || "";
      const email =
        document.getElementById("contact-email")?.value.trim() || "";
      const subject =
        document.getElementById("contact-subject")?.value.trim() || "";
      const rawMessage =
        document.getElementById("contact-message")?.value.trim() || "";

      if (!name || !email || !subject || !rawMessage) {
        showToast(
          "error",
          "Error de envío",
          "Por favor completa tu nombre, correo, asunto y mensaje antes de enviar.",
        );
        return;
      }

      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(email)) {
        showToast(
          "error",
          "Error de envío",
          "Por favor ingresa una dirección de correo electrónico válida.",
        );
        return;
      }

      let finalDescription = `-> Nombre: ${name}\n`;
      if (phone) {
        finalDescription += `-> Telefono: ${phone}\n`;
      }
      finalDescription += `-> Correo: ${email}\n\n`;
      finalDescription += rawMessage;

      if (submitBtn) submitBtn.disabled = true;
      if (btnText) btnText.textContent = "Enviando mensaje...";

      const formData = new FormData();
      formData.append("access_key", accessKey);
      formData.append("name", name);
      formData.append("email", email);
      formData.append("subject", subject);
      formData.append("message", finalDescription);

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: formData,
        });

        const data = await response.json();

        if (data.success) {
          showToast(
            "success",
            "Envío exitoso",
            "Gracias por ponerte en contacto. Te responderé lo más pronto posible.",
          );
          form.reset();
        } else {
          throw new Error(data.message || "Error al procesar el envío.");
        }
      } catch (err) {
        showToast(
          "error",
          "Error de envío",
          "No se pudo enviar el correo en este momento. Inténtalo de nuevo o escríbeme directamente.",
        );
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        if (btnText) btnText.textContent = "Enviar mensaje";
      }
    });
  }

  document.addEventListener("DOMContentLoaded", initContactForm);
  document.addEventListener("astro:page-load", initContactForm);
  if (document.readyState !== "loading") initContactForm();
</script>
