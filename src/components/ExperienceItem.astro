---
import { ChevronRight } from "@lucide/astro";

interface Props {
  title: string;
  company: string;
  description: string;
  link?: string;
  date: string;
}
const { title, company, description, link, date } = Astro.props;
---

<div
  class="relative pl-10 md:pl-16 reveal"
  style={`animation-delay: var(--delay, 0ms)`}
>
  <!-- Timeline dot -->
  <div
    class="absolute left-[11px] md:left-[27px] top-1 size-3 rounded-full bg-[var(--color-accent)] shadow-[0_0_10px_var(--color-glow-strong)] ring-4 ring-[var(--color-bg-primary)]"
  >
  </div>

  <!-- Card -->
  <div
    class="glass rounded-xl p-5 md:p-6 transition-all duration-300 hover:border-[var(--color-accent)]/20"
  >
    <div
      class="flex flex-col md:flex-row md:items-start md:justify-between gap-2 mb-3"
    >
      <div>
        <h3 class="text-lg font-bold text-[var(--color-text-primary)]">
          {title}
        </h3>
        {
          company && (
            <h4 class="text-sm font-medium text-[var(--color-accent)]">
              {company}
            </h4>
          )
        }
      </div>
      <time
        class="text-xs font-medium px-3 py-1 rounded-full bg-[var(--color-accent)]/10 text-[var(--color-accent)] whitespace-nowrap self-start"
      >
        {date}
      </time>
    </div>

    <p class="text-sm leading-relaxed text-[var(--color-text-secondary)]">
      {description}
    </p>

    {
      link && (
        <a
          href={link}
          class="inline-flex items-center gap-1 mt-3 text-sm font-medium text-[var(--color-accent)] hover:text-[var(--color-accent-secondary)] transition-colors"
        >
          Saber más
          <ChevronRight class="size-4" />
        </a>
      )
    }
  </div>
</div>
