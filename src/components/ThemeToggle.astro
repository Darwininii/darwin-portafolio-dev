---
import { Sun, Moon } from "@lucide/astro";
---

<button
  class="theme-toggle-btn flex items-center justify-center size-9 rounded-lg hover:bg-[var(--color-bg-card)] transition-all duration-200 hover:scale-110"
  aria-label="Cambiar tema"
>
  <span class="theme-icon-sun">
    <Sun class="size-5 text-black dark:text-[var(--color-accent-warm)]" />
  </span>
  <span class="theme-icon-moon hidden">
    <Moon class="size-5 text-[var(--color-accent)]" />
  </span>
</button>

<script is:inline>
  if (!window.__themeToggleInit) {
    window.__themeToggleInit = true;

    (function () {
      var matchMedia = window.matchMedia("(prefers-color-scheme: dark)");

      function isDarkMode() {
        return document.documentElement.classList.contains("dark");
      }

      function updateIcons() {
        var dark = isDarkMode();
        document.querySelectorAll(".theme-icon-sun").forEach(function (el) {
          el.classList.toggle("hidden", dark);
        });
        document.querySelectorAll(".theme-icon-moon").forEach(function (el) {
          el.classList.toggle("hidden", !dark);
        });
      }

      function applyTheme() {
        var saved = localStorage.getItem("theme");
        var shouldBeDark = saved === "dark" || (!saved && matchMedia.matches);

        document.documentElement.classList.toggle("dark", shouldBeDark);
        updateIcons();
      }

      // Initial apply
      applyTheme();

      // Listen for system preference changes
      matchMedia.addEventListener("change", function () {
        if (!localStorage.getItem("theme")) {
          applyTheme();
        }
      });

      // Click handler — toggle dark ↔ light
      document.addEventListener("click", function (e) {
        var btn = e.target.closest(".theme-toggle-btn");
        if (!btn) return;

        var dark = isDarkMode();
        localStorage.setItem("theme", dark ? "light" : "dark");
        document.documentElement.classList.toggle("dark", !dark);
        updateIcons();
      });

      // Astro page transitions
      document.addEventListener("astro:after-swap", function () {
        window.__themeToggleInit = false;
        applyTheme();
      });
    })();
  } else {
    // Si la inicialización ya pasó, solo actualizamos los iconos recién montados (el toggle móvil)
    var isDark = document.documentElement.classList.contains("dark");
    document.querySelectorAll(".theme-icon-sun").forEach(function (el) {
      el.classList.toggle("hidden", isDark);
    });
    document.querySelectorAll(".theme-icon-moon").forEach(function (el) {
      el.classList.toggle("hidden", !isDark);
    });
  }
</script>
