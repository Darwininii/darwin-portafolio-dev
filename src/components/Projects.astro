---
import {
  SiWordpress,
  SiJavascript,
  SiTailwindcss,
  SiNextdotjs,
  SiAstro,
  SiFirebase,
  SiReact,
  SiTypescript,
  SiVite,
  SiSupabase,
  SiCss,
  SiGithub,
} from "react-icons/si";
import { FaCircleArrowDown } from "react-icons/fa6";
import { ExternalLink, ChevronDown } from "@lucide/astro";
import LinkButton from "./LinkButton.astro";

const TAGS = {
  WORDPRESS: {
    name: "WordPress",
    icon: SiWordpress,
    class:
      "bg-[#21759B]/10 dark:bg-[#21759B]/20 text-[#21759B] dark:text-blue-300 border-[#21759B]/20",
  },
  GITHUB: {
    name: "GitHub",
    icon: SiGithub,
    class:
      "bg-black/5 dark:bg-white/5 text-black dark:text-[var(--color-text-primary)] border-black/10 dark:border-white/10",
  },
  JAVASCRIPT: {
    name: "JavaScript",
    icon: SiJavascript,
    class:
      "bg-[#F7DF1E]/20 dark:bg-[#F7DF1E]/10 text-[#B4A000] dark:text-[#F7DF1E] border-[#F7DF1E]/30 dark:border-[#F7DF1E]/20",
  },
  TAILWIND: {
    name: "Tailwind",
    icon: SiTailwindcss,
    class:
      "bg-[#06B6D4]/10 text-[#0891B2] dark:text-[#06B6D4] border-[#06B6D4]/20",
  },
  NEXTJS: {
    name: "Next.js",
    icon: SiNextdotjs,
    class:
      "bg-black/5 dark:bg-white/5 text-black dark:text-[var(--color-text-primary)] border-black/10 dark:border-white/10",
  },
  ASTROICON: {
    name: "Astro",
    icon: SiAstro,
    class:
      "bg-[#FF5D01]/10 text-[#D04B00] dark:text-[#FF5D01] border-[#FF5D01]/20",
  },
  FIREBASE: {
    name: "Firebase",
    icon: SiFirebase,
    class:
      "bg-[#FFCA28]/20 dark:bg-[#FFCA28]/10 text-[#D97706] dark:text-[#FFCA28] border-[#FFCA28]/30 dark:border-[#FFCA28]/20",
  },
  REACT: {
    name: "React",
    icon: SiReact,
    class:
      "bg-[#61DAFB]/20 dark:bg-[#61DAFB]/10 text-[#0284C7] dark:text-[#61DAFB] border-[#61DAFB]/30 dark:border-[#61DAFB]/20",
  },
  TYPESCRIPT: {
    name: "TypeScript",
    icon: SiTypescript,
    class:
      "bg-[#3178C6]/10 text-[#2563EB] dark:text-blue-400 border-[#3178C6]/20",
  },
  VITE: {
    name: "Vite",
    icon: SiVite,
    class:
      "bg-[#646CFF]/10 dark:bg-purple-500/10 text-[#4F46E5] dark:text-purple-400 border-[#646CFF]/20",
  },
  SUPABASE: {
    name: "Supabase",
    icon: SiSupabase,
    class:
      "bg-[#3ECF8E]/10 text-[#059669] dark:text-[#3ECF8E] border-[#3ECF8E]/20",
  },
  CSS: {
    name: "CSS",
    icon: SiCss,
    class:
      "bg-[#1572B6]/10 dark:bg-cyan-500/15 text-[#1572B6] dark:text-blue-300 border-[#1572B6]/20",
  },
};

const PROJECTS = [
  {
    title: "Grupo Colega",
    description:
      "Rediseño integral de la página web para Grupo Colega, destacada empresa mexicana de seguridad privada. El proyecto consistió en la migración de su sitio heredado en WordPress a una arquitectura moderna construida desde cero con React y Vite. Utilizando JavaScript puro y Tailwind CSS, se le otorgó un aire completamente renovado y profesional, incorporando animaciones fluidas que resaltan sus servicios de vigilancia 24/7, custodia corporativa y seguridad electrónica, garantizando una excelente experiencia de usuario.",
    link: "https://grupo-colega.vercel.app/",
    image: "/projects/Grupo-Colega.png",
    tags: [TAGS.REACT, TAGS.JAVASCRIPT, TAGS.TAILWIND],
  },
  {
    title: "Zona Forense",
    description:
      "Desarrollo de página web corporativa para Zona Forense & Staff Seguridad, enfocada en proyectar la identidad y profesionalismo de la compañía. La plataforma estructura de manera clara su información institucional, abarcando su misión, visión y áreas de especialidad como Investigaciones, Pruebas Periciales, Informática Forense y Representación Legal. Construida en WordPress y complementada con estilos personalizados en CSS, asegurando una experiencia de usuario fluida, moderna y un diseño responsivo.",
    link: "https://www.zonaforense.com/",
    image: "/projects/Zona_Forense-01.png",
    tags: [TAGS.WORDPRESS, TAGS.CSS],
  },
  {
    title: "Darwinini Ecommerce",
    description:
      "Desarrollé una aplicación de Ecommerce (comercio electrónico) como proyecto personal, con el objetivo de poner en práctica mis conocimientos en desarrollo web fullstack. La plataforma cuenta con un sistema de autenticación de usuarios, catálogo de productos con filtros y búsqueda avanzada, carrito de compras interactivo, integración de pasarela de pagos, panel de administración para gestión de inventario y pedidos, y un diseño responsivo optimizado para todo tipo de dispositivos. Construida con React y Vite para un rendimiento ultrarrápido, estilizada con Tailwind CSS y respaldada por Supabase como backend.",
    link: "https://darwinini-ecommerce.vercel.app/",
    github: "https://github.com/Darwininii/Alma-Cafe.git",
    image: "/projects/ecommerce.png",
    images: ["/projects/ecommerce.png", "/projects/ecommerce-2.png"],
    tags: [
      TAGS.REACT,
      TAGS.TYPESCRIPT,
      TAGS.VITE,
      TAGS.TAILWIND,
      TAGS.SUPABASE,
      TAGS.GITHUB,
    ],
  },
  {
    title: "AireTec",
    description:
      "Desarrollo de una pagina de presentación para la empresa AireTec, dedicada a la venta e instalación de aires acondicionados. La página web fue creada utilizando Next.js y Tailwind CSS para asegurar una experiencia de usuario moderna y responsiva.",
    link: "https://aire-tec-darw.vercel.app/",
    github: "https://github.com/Darwininii/AireTec-main",
    image: "/projects/AireTec.webp",
    tags: [TAGS.REACT, TAGS.NEXTJS, TAGS.TYPESCRIPT, TAGS.TAILWIND],
  },
  {
    title: "QR-Darw",
    description:
      "Desarrollo de una pagina web para generar Código QR. Ya había realizado un proyecto similar anteriormente, sin embargo queria mejorar la interfaz visual, la experiencia y usar Studio.Firebase como una manera rapida de la creacion de una pagina web.",
    link: "https://qr-darw.vercel.app/",
    github: "https://github.com/Darwininii/QR-Darw",
    image: "/projects/QR-Darwin.webp",
    tags: [TAGS.REACT, TAGS.NEXTJS, TAGS.TYPESCRIPT, TAGS.TAILWIND],
  },
  {
    title: "Resto-Bar Insignia",
    description:
      "Desarrollo y mantenimiento de la página web para el Resto-Bar Insignia, utilizando WordPress. Implementación de estrategias SEO para mejorar la visibilidad en motores de búsqueda y asegurar un rendimiento óptimo del sitio.",
    link: "https://restauranteinsignia.com/",
    image: "/projects/Insignia.webp",
    tags: [TAGS.WORDPRESS, TAGS.CSS],
  },
  {
    title: "AutoSinergia",
    description:
      "Desarrollo y mantenimiento de la página web para AutoSinergia, utilizando WordPress. Gestion de contenido, optimización SEO y mantenimiento técnico para asegurar un rendimiento óptimo del sitio.",
    link: "https://autosinergia.com/",
    image: "/projects/AutoSinergia.webp",
    tags: [TAGS.WORDPRESS, TAGS.CSS],
  },
  {
    title: "QR-Generator",
    description:
      "Desarrollo de un generador de códigos QR utilizando JavaScript en Next.js.",
    link: "https://qr-generator-chi-eight.vercel.app/",
    github: "https://github.com/Darwininii/qr-generator",
    image: "/projects/QR-Generator.webp",
    tags: [TAGS.GITHUB, TAGS.JAVASCRIPT, TAGS.TAILWIND, TAGS.NEXTJS],
  },
  {
    title: "Portafolio",
    description:
      "Desarrollo de mi portafolio personal utilizando Astro y Tailwind CSS para mostrar mis proyectos y habilidades como desarrollador web.",
    github: "https://github.com/Darwininii/darwin-portafolio-dev.git",
    image: "/projects/Portafolio.webp",
    tags: [TAGS.GITHUB, TAGS.TAILWIND, TAGS.ASTROICON],
  },
];
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
  {
    PROJECTS.map(
      ({ title, description, image, images, tags, link, github }, i) => (
        <article
          class={`group glass rounded-2xl overflow-hidden transition-all duration-500 hover:shadow-[0_0_40px_var(--color-glow)] hover:border-[var(--color-accent)]/20 hover:-translate-y-1 project-card reveal ${i >= 6 ? "hidden" : ""}`}
          style={`animation-delay: ${i < 6 ? i * 100 : 0}ms`}
        >
          {/* Image — if multiple images, show a gallery */}
          <div class="relative overflow-hidden aspect-video">
            {images && images.length > 1 ? (
              <div
                class="project-gallery relative w-full h-full"
                data-current="0"
              >
                {images.map((img, idx) => (
                  <img
                    alt={`Proyecto: ${title} - ${idx + 1}`}
                    class={`absolute inset-0 object-cover object-top w-full h-full transition-opacity duration-500 ${idx === 0 ? "opacity-100" : "opacity-0"}`}
                    data-gallery-img={idx.toString()}
                    loading="lazy"
                    src={img}
                  />
                ))}
                {/* Gallery dots */}
                <div class="absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-2 z-10">
                  {images.map((_, idx) => (
                    <button
                      class={`gallery-dot size-2 rounded-full transition-all ${idx === 0 ? "bg-white scale-125" : "bg-white/40"}`}
                      data-dot={idx.toString()}
                      aria-label={`Imagen ${idx + 1}`}
                    />
                  ))}
                </div>
                {/* Nav arrows */}
                <button
                  class="gallery-prev absolute left-2 top-1/2 -translate-y-1/2 z-10 p-1.5 rounded-full bg-black/50 text-white hover:bg-black/80 transition-colors opacity-0 group-hover:opacity-100"
                  aria-label="Anterior"
                >
                  <svg
                    class="size-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M15 18l-6-6 6-6" />
                  </svg>
                </button>
                <button
                  class="gallery-next absolute right-2 top-1/2 -translate-y-1/2 z-10 p-1.5 rounded-full bg-black/50 text-white hover:bg-black/80 transition-colors opacity-0 group-hover:opacity-100"
                  aria-label="Siguiente"
                >
                  <svg
                    class="size-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M9 18l6-6-6-6" />
                  </svg>
                </button>
              </div>
            ) : (
              <img
                alt={`Proyecto: ${title}`}
                class="object-cover object-top w-full h-full transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
                src={image}
              />
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-bg-primary)] via-transparent to-transparent opacity-60 pointer-events-none" />

            {/* Hover overlay with links */}
            <div class="absolute inset-0 flex items-center justify-center gap-3 opacity-0 group-hover:opacity-100 transition-opacity duration-300 bg-black/80 backdrop-blur-sm">
              {github && (
                <a
                  href={github}
                  target="_blank"
                  rel="noopener"
                  class="p-3 rounded-full bg-black text-white border border-white/20 hover:bg-white hover:text-black hover:scale-110 transition-all duration-200"
                  aria-label="Ver código en GitHub"
                >
                  <SiGithub size={14} />
                </a>
              )}
              {link && (
                <a
                  href={link}
                  target="_blank"
                  rel="noopener"
                  class="p-3 rounded-full bg-black text-white border border-white/20 hover:bg-white hover:text-black hover:scale-110 transition-all duration-200"
                  aria-label="Visitar sitio"
                >
                  <ExternalLink class="size-5" />
                </a>
              )}
            </div>
          </div>

          {/* Content */}
          <div class="p-5">
            <h3 class="text-lg font-bold text-[var(--color-text-primary)] mb-2">
              {title}
            </h3>

            {/* Tags */}
            <ul class="flex flex-wrap gap-1.5 mb-3">
              {tags.map((tag) => {
                const Icon = tag.icon;
                return (
                  <li>
                    <span
                      class={`inline-flex items-center gap-1.5 rounded-full text-[11px] font-medium px-2.5 py-0.5 border ${tag.class}`}
                    >
                      <Icon size={14} />
                      {tag.name}
                    </span>
                  </li>
                );
              })}
            </ul>

            {/* Description with "Leer más" */}
            <div class="project-desc-wrapper">
              <p class="project-desc text-sm text-[var(--color-text-secondary)] leading-relaxed line-clamp-3">
                {description}
              </p>
              <button class="read-more-btn mt-2 inline-flex items-center gap-1 text-xs font-medium text-[var(--color-accent)] hover:text-[var(--color-accent-secondary)] transition-colors">
                <span class="read-more-text">Leer más</span>
                <ChevronDown class="size-3.5 read-more-icon transition-transform duration-200" />
              </button>
            </div>

            {/* Bottom links */}
            <div class="flex items-center gap-3 mt-4 pt-4 border-t border-[var(--color-border)]">
              {github && (
                <LinkButton href={github}>
                  <SiGithub size={14} />
                  Código
                </LinkButton>
              )}
              {link && (
                <LinkButton href={link}>
                  <ExternalLink class="size-4" />
                  Visitar
                </LinkButton>
              )}
            </div>
          </div>
        </article>
      ),
    )
  }
</div>

{
  PROJECTS.length > 6 && (
    <div
      id="show-more-container"
      class="flex flex-col items-center mt-12 gap-2 reveal transition-all duration-500"
      style="animation-delay: 200ms;"
    >
      {/* 3 dots */}
      <div class="flex flex-col gap-2 mb-3 items-center">
        <div class="size-[7px] rounded-full bg-[var(--color-accent)] shadow-[0_0_8px_var(--color-glow-strong)] ring-[3px] ring-black/15 dark:ring-white/20 opacity-40" />
        <div class="size-[9px] rounded-full bg-[var(--color-accent)] shadow-[0_0_10px_var(--color-glow-strong)] ring-[3px] ring-black/15 dark:ring-white/20 opacity-70" />
        <div class="size-[12px] rounded-full bg-[var(--color-accent)] shadow-[0_0_12px_var(--color-glow-strong)] ring-[4px] ring-black/15 dark:ring-white/20" />
      </div>

      {/* Button */}
      <button
        id="btn-show-more"
        class="flex flex-col items-center gap-2 text-[var(--color-accent)] hover:text-[var(--color-accent-secondary)] group transition-all duration-300 cursor-pointer"
        aria-label="Ver más proyectos"
      >
        <span class="transition-transform duration-300 group-hover:translate-y-1 group-hover:scale-110">
          <FaCircleArrowDown size={30} />
        </span>
        <span class="text-sm font-semibold tracking-wider uppercase mt-1">
          Ver más proyectos
        </span>
      </button>
    </div>
  )
}

<script is:inline>
  function initProjects() {
    // Show More Projects logic
    var showMoreBtn = document.getElementById("btn-show-more");
    var container = document.getElementById("show-more-container");
    if (showMoreBtn && !showMoreBtn.dataset.init) {
      showMoreBtn.dataset.init = "true";
      showMoreBtn.addEventListener("click", function () {
        var hiddenCards = document.querySelectorAll(".project-card.hidden");
        hiddenCards.forEach(function (card, idx) {
          card.classList.remove("hidden");
          setTimeout(function () {
            card.style.animationDelay = idx * 100 + "ms";
          }, 10);
        });
        if (container) {
          container.style.opacity = "0";
          container.style.transform = "translateY(-20px)";
          setTimeout(function () {
            container.style.display = "none";
          }, 300);
        }
      });
    }

    // "Leer más" toggle
    document.querySelectorAll(".read-more-btn").forEach(function (btn) {
      // Avoid duplicate listeners
      if (btn.dataset.init) return;
      btn.dataset.init = "true";

      btn.addEventListener("click", function () {
        var wrapper = btn.closest(".project-desc-wrapper");
        var desc = wrapper ? wrapper.querySelector(".project-desc") : null;
        var text = btn.querySelector(".read-more-text");
        var icon = btn.querySelector(".read-more-icon");

        if (!desc) return;

        var isClamped = desc.classList.contains("line-clamp-3");

        if (isClamped) {
          desc.classList.remove("line-clamp-3");
          desc.style.display = "block";
          desc.style.webkitLineClamp = "unset";
          desc.style.overflow = "visible";
          if (text) text.textContent = "Leer menos";
          if (icon) icon.style.transform = "rotate(180deg)";
        } else {
          desc.classList.add("line-clamp-3");
          desc.style.display = "";
          desc.style.webkitLineClamp = "";
          desc.style.overflow = "";
          if (text) text.textContent = "Leer más";
          if (icon) icon.style.transform = "";
        }
      });
    });

    // Image gallery navigation
    document.querySelectorAll(".project-gallery").forEach(function (gallery) {
      if (gallery.dataset.init) return;
      gallery.dataset.init = "true";

      var imgs = gallery.querySelectorAll("[data-gallery-img]");
      var dots = gallery.querySelectorAll(".gallery-dot");
      var prevBtn = gallery.querySelector(".gallery-prev");
      var nextBtn = gallery.querySelector(".gallery-next");
      var current = 0;
      var total = imgs.length;

      function showSlide(idx) {
        current = ((idx % total) + total) % total;
        imgs.forEach(function (img, i) {
          img.classList.toggle("opacity-100", i === current);
          img.classList.toggle("opacity-0", i !== current);
        });
        dots.forEach(function (dot, i) {
          dot.classList.toggle("bg-white", i === current);
          dot.classList.toggle("scale-125", i === current);
          dot.classList.toggle("bg-white/40", i !== current);
        });
      }

      if (prevBtn)
        prevBtn.addEventListener("click", function (e) {
          e.stopPropagation();
          showSlide(current - 1);
        });
      if (nextBtn)
        nextBtn.addEventListener("click", function (e) {
          e.stopPropagation();
          showSlide(current + 1);
        });
      dots.forEach(function (dot, i) {
        dot.addEventListener("click", function (e) {
          e.stopPropagation();
          showSlide(i);
        });
      });
    });
  }

  // Run on initial load and on Astro page transitions
  document.addEventListener("DOMContentLoaded", initProjects);
  document.addEventListener("astro:page-load", initProjects);
  // Also run immediately in case DOMContentLoaded already fired
  if (document.readyState !== "loading") initProjects();
</script>
