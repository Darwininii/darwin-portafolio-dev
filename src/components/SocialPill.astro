---
interface Props {
  href?: string;
  type?: "button" | "submit" | "reset";
  target?: string;
  id?: string;
  class?: string;
}

const {
  href,
  type = "button",
  target,
  id,
  class: className = "",
  ...props
} = Astro.props;

// Si empieza con '#' es un ancla interna y se abre en la misma ventana ('_self')
// Si es un enlace externo, abre en nueva pestaña ('_blank')
const isInternalLink = href?.startsWith("#");
const computedTarget = target ?? (isInternalLink ? "_self" : "_blank");
const computedRel =
  computedTarget === "_blank" ? "noopener noreferrer" : undefined;

const baseStyles =
  "inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-full text-sm font-medium transition-all duration-300 glass text-[var(--color-text-primary)] hover:border-[var(--color-accent)]/30 hover:shadow-[0_0_20px_var(--color-glow)] hover:text-[var(--color-accent)] hover:scale-105 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-bg-primary)] active:scale-95 disabled:opacity-60 disabled:cursor-not-allowed cursor-pointer";
---

{
  href ? (
    <a
      href={href}
      target={computedTarget}
      rel={computedRel}
      role="button"
      class={`${baseStyles} ${className}`}
      {...props}
    >
      <slot />
    </a>
  ) : (
    <button type={type} id={id} class={`${baseStyles} ${className}`} {...props}>
      <slot />
    </button>
  )
}
