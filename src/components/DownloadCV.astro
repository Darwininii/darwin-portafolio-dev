---
import { Download } from "@lucide/astro";
---

<div class="flex justify-center mt-8 reveal">
  <a
    href="/Darwin_Nino_2026.pdf"
    download
    class="group relative inline-flex items-center justify-center gap-3 px-6 py-3 text-base font-semibold rounded-xl overflow-hidden transition-all duration-300 hover:scale-105 hover:shadow-[0_0_30px_var(--color-glow)] active:scale-95"
  >
    <!-- Gradient background -->
    <div
      class="absolute inset-0 bg-gradient-to-r from-[var(--color-accent)] to-[var(--color-accent-secondary)] transition-opacity duration-300"
    >
    </div>
    <!-- Shimmer overlay -->
    <div
      class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent animate-shimmer opacity-0 group-hover:opacity-100 transition-opacity"
    >
    </div>
    <!-- Content -->
    <Download class="relative size-5 text-white" />
    <span class="relative text-white">Descargar Curriculum Vitae</span>
  </a>
</div>
