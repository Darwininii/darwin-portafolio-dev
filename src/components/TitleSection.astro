---
const { class: className } = Astro.props;
---

<div class={`flex items-center gap-4 mb-10 reveal ${className || ""}`}>
  <h2
    class="flex items-center gap-3 text-2xl md:text-3xl font-bold text-[var(--color-text-primary)]"
  >
    <slot />
  </h2>
  <div
    class="flex-1 h-px bg-gradient-to-r from-[var(--color-accent)]/40 to-transparent"
  >
  </div>
</div>
