---
const { href } = Astro.props;
---

<a
  target="_blank"
  rel="noopener noreferrer"
  href={href}
  role="link"
  class="inline-flex items-center justify-center gap-2 px-4 py-2 text-sm font-medium rounded-lg transition-all duration-300 text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] hover:bg-[var(--color-accent)]/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]"
>
  <slot />
</a>
